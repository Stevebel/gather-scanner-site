---
// Sections 11–12 — Final call-to-action, follow channels, and requirements.
import { links, requirements } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="get-started" class="w-full text-center flex flex-col gap-10 mt-8 border-t border-surface-border pt-16 scroll-mt-24">
  <div class="flex flex-col items-center gap-6">
    <h2 class="text-display font-display text-on-surface">Get your collection together.</h2>
    <p class="text-body-lg font-body-lg text-on-surface-variant max-w-lg">
      Gather Scanner is coming soon to the App Store. Follow along to catch the launch.
    </p>
    <div class="flex flex-col sm:flex-row justify-center gap-4 w-full max-w-md mx-auto mt-2">
      <a
        href={links.discord}
        class="flex-1 py-4 rounded-xl bg-surface-elevated border border-primary text-primary text-label-md font-label-md hover:bg-surface-container-high transition-colors flex items-center justify-center gap-2"
      >
        <Icon name="forum" class="text-[20px]" />
        Join the Discord
      </a>
      <a
        href={links.bluesky}
        class="flex-1 py-4 rounded-xl bg-transparent border border-surface-border text-on-surface-variant text-label-md font-label-md hover:text-on-surface hover:bg-surface-container transition-colors flex items-center justify-center gap-2"
      >
        <Icon name="alternate_email" class="text-[20px]" />
        Follow on Bluesky
      </a>
    </div>
  </div>

  <div
    class="bg-surface-container p-6 rounded-xl border border-surface-border max-w-2xl mx-auto w-full text-left"
  >
    <h3 class="text-label-md font-label-md text-on-surface mb-4 uppercase tracking-wider">
      What you'll need
    </h3>
    <ul class="flex flex-col gap-2 text-body-md font-body-md text-on-surface-variant">
      {
        requirements.map((req) => (
          <li class="flex items-center gap-2">
            <Icon name={req.icon} class="text-primary text-[18px] shrink-0" />
            <span set:html={req.html} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

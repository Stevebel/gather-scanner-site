---
// Sections 4–7 — Organize (with screenshot), Borrow-from-deck, Value, and Settings.
// Mirrors the mockup's two-column grid: one tall feature on the left, three cards right.
import CheckList from "./CheckList.astro";
import FeatureCard from "./FeatureCard.astro";

const organizePoints = [
  "Unlimited locations, decks, and lists.",
  "Built to find your cards, no matter how large the collection.",
];
---

<section class="w-full grid grid-cols-1 md:grid-cols-2 gap-8 scroll-mt-24" id="collection">
  <!-- Section 4 — Organize. (DOM-first so it leads on mobile; shown in the right
       column on desktop via order utilities.) -->
  <div
    class="md:order-2 bg-surface-elevated p-8 rounded-2xl border border-surface-border flex flex-col justify-between gap-6"
  >
    <div>
      <h2 class="text-headline-lg font-headline-lg text-on-surface mb-4">
        Unlimited binders, boxes, and decks.
      </h2>
      <div class="flex justify-around flex-wrap gap-2 -mt-2 mb-2 text-on-surface/70">
        <div>"Trade Binder"</div>
        <div class="mt-2">"STX Bulk Box"</div>
        <div>"Mono U Tempo"</div>
      </div>
      <p class="text-body-md font-body-md text-on-surface-variant mb-6">
        Gather Scanner lets you organize your virtual collection to match
        your physical one.
      </p>
      <CheckList items={organizePoints} />
    </div>
    <div class="w-full max-w-sm self-center">
      <img
        src="inventory.jpg"
        alt="The inventory view with several locations and decks set up"
        width="1170"
        height="2532"
        class="w-full rounded-[2rem] border-4 border-surface-container-high shadow-lg"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Sections 5–7 -->
  <div class="md:order-1 flex flex-col gap-8">
    <FeatureCard title="Pulled a card from another deck?">
      We've all grabbed a card from one deck to finish another. Gather Scanner
      tracks where cards are borrowed from, so you know exactly what's missing 
      and which deck is using it.
    </FeatureCard>
    <FeatureCard title="Keep an eye on your collection's value.">
      Gather Scanner tracks card prices so you can see what your collection is
      worth and spot what's moving. Prices update daily so you can check your
      trades without digging through marketplaces.
    </FeatureCard>
    <FeatureCard title="Tune it to your tastes.">
      Flexible settings let you tune the scanner to your liking. 
      Choose between higher speed or better accuracy, 
      scan hands-free with gestures, and enable power-saving 
      when you're away from an outlet.
    </FeatureCard>
  </div>
</section>

---
// Section 8 — Privacy / data ownership.
import Icon from "./Icon.astro";
import CheckList from "./CheckList.astro";
import { withBase } from "../data/site";

const points = [
  "No account, no sign-in, no email address.",
  "Export your collection anytime, no lock-in.",
  "Card recognition runs offline. Nothing is sent off device.",
];
---

<section
  class="w-full bg-surface-elevated py-16 px-8 rounded-3xl text-center border border-surface-border relative overflow-hidden scroll-mt-24"
  id="privacy"
>
  <div
    class="absolute top-0 right-0 w-64 h-64 bg-primary/5 blur-3xl rounded-full translate-x-1/2 -translate-y-1/2"
  >
  </div>
  <div class="flex flex-col gap-6 relative z-10 items-center">
    <Icon name="shield_lock" class="text-[48px] text-on-surface mb-2" filled />
    <h2 class="text-display font-display text-on-surface w-full">
      No accounts. No tracking. Your collection is yours.
    </h2>
    <div class="max-w-3xl flex flex-col gap-6 items-center">
      <p class="text-body-lg font-body-lg text-on-surface-variant">
        Open the app and start scanning. There's nothing to sign up for. Your collection lives on
        your phone, not on a server somewhere. Gather Scanner can't sell your data, because it never
        collects it in the first place.
      </p>
      <CheckList items={points} class="mt-4 text-left w-full max-w-xl" />
      <div
        class="bg-surface-container-high p-6 rounded-xl border border-surface-border text-left w-full mt-4"
      >
        <p class="text-body-md font-body-md text-on-surface mb-2">
          <strong class="text-primary font-bold">Help the scanner get smarter, only if you want to.</strong>
          You can opt in to share corrections you make to scans. This data is anonymous and used only to improve the scanner's recognition for everyone. Off
          by default, anonymous, and yours to turn off anytime.
        </p>
        <a
          class="text-primary hover:text-primary-fixed transition-colors font-label-md"
          href={withBase("/privacy#whats-shared")}>See exactly what's shared →</a
        >
      </div>
    </div>
  </div>
</section>

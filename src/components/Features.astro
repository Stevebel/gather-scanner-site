---
// Section 2 — depth of recognition (finish, printing, on-device).
// Header preserved from the mockup per request; proof points follow the content spec.
import Icon from "./Icon.astro";

const cards = [
  {
    icon: "smartphone",
    title: "Recognition runs entirely on your phone",
    body: "No account, nothing sent off to figure out your cards. That makes it fast and private, and it works with zero signal at the game store or on a plane.",
  },
  {
    icon: "auto_awesome",
    title: "Foil, etched, or non-foil",
    body: "Gather Scanner detects a card's finish automatically, something other scanners don't even attempt. Not sure it got it right? A quick tilt confirms it.",
  },
  {
    icon: "content_copy",
    title: "Printing-aware, not just name-aware",
    body: "It recognizes which printing you're holding and gets you to the right set and version most of the time. When reprints share art or treatments, picking the exact one is a single tap.",
  },
];
---

<section class="w-full flex flex-col gap-16" id="features">
  <div class="text-center max-w-3xl mx-auto">
    <h2 class="text-headline-lg font-headline-lg text-on-surface mb-4">
      You won't believe the results you get with just your phone
    </h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {
      cards.map((card) => (
        <div class="bg-surface-elevated p-8 rounded-2xl border border-surface-border flex flex-col gap-4">
          <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center border border-surface-border">
            <Icon name={card.icon} class="text-primary text-2xl" />
          </div>
          <h3 class="text-headline-md font-headline-md text-on-surface">{card.title}</h3>
          <p class="text-body-md font-body-md text-on-surface-variant">{card.body}</p>
        </div>
      ))
    }
  </div>
</section>

---
// Section 2 — shown on mobile/tablet only. Desktop gets these cards inline in the hero.
import Icon from "./Icon.astro";
import { featureCards as cards } from "../data/features";
---

<section class="md:hidden w-full flex flex-col gap-16" id="features">
  <div class="text-center max-w-3xl mx-auto">
    <h2 class="text-headline-lg font-headline-lg text-on-surface mb-4">
      You won't believe the results you get with just your phone
    </h2>
  </div>
  <div class="grid grid-cols-1 gap-3">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group leading-tight bg-surface-elevated px-5 py-4 rounded-2xl border border-surface-border hover:border-primary/50 hover:bg-surface-container-high transition-colors flex flex-col gap-2"
        >
          <h3 class="text-label-lg font-label-lg text-on-surface group-hover:text-primary transition-colors flex items-center gap-2 min-h-[3em]">
            <Icon name={card.icon} class="text-primary text-xl shrink-0" />
            <span set:html={card.title} />
          </h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant">{card.body}</p>
        </a>
      ))
    }
  </div>
</section>
